NEXT_PUBLIC_APP_URL=http://localhost:3000
# Choose: openai | anthropic | google
AI_PROVIDER=openai
# Server-side secrets only; never commit real values
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash
# Enable only when a trusted reverse proxy overwrites these client IP headers.
TRUST_PROXY_HEADERS=false
