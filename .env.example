NEXT_PUBLIC_APP_URL=http://localhost:3000
# Choose one provider explicitly, or "auto" to fail over between configured providers.
AI_PROVIDER=auto
# In auto mode, providers are tried in this order. Only providers with a non-empty key are used.
AI_PROVIDER_ORDER=google,openai,anthropic
# Server-side secrets only; never commit real values. Configure one or more providers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash
# Enable only when a trusted reverse proxy overwrites these client IP headers.
TRUST_PROXY_HEADERS=false
